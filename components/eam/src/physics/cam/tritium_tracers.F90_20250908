!===============================================================================
! Tritium Fate & Transport (single passive tracer with decay and injection)
! One-time surface injection of tritium tracer (TRIT, in mass mixing ratio units)
! at a specified location and time. Structure mirrors AOA tracers (register,
! implements, init_cnst, init, timestep_init, timestep_tend, readnl).
!===============================================================================

module tritium_tracers

  use shr_kind_mod, only: r8 => shr_kind_r8
  use spmd_utils,   only: masterproc
  use ppgrid,       only: pcols, pver, begchunk, endchunk
  use constituents, only: pcnst, cnst_add, cnst_name, cnst_longname
  use cam_logfile,  only: iulog

  implicit none
  private
  save

  ! Public interfaces
  public :: tritium_tracers_register
  public :: tritium_tracers_implements_cnst
  public :: tritium_tracers_init_cnst
  public :: tritium_tracers_init
  public :: tritium_tracers_timestep_init
  public :: tritium_tracers_timestep_tend
  public :: tritium_tracers_readnl

  !-------------------------------------------------------------
  ! Constituents (AOA-like structure)
  !-------------------------------------------------------------
  integer, parameter :: ncnst = 1

  character(len=8), parameter :: c_names(ncnst)   = (/'TRIT'/)
  character(len=8), parameter :: src_names(ncnst) = (/'TRITSRC'/)  ! surface flux diag (kg/m2/s)
  character(len=8), parameter :: dec_names(ncnst) = (/'TRITDEC'/)  ! decay tendency (kg/kg/s)

  integer :: ifirst     ! global index of first constituent
  integer :: ixtrit     ! global index for TRIT tracer

  !-------------------------------------------------------------
  ! Namelist controls
  !-------------------------------------------------------------
  logical :: tritium_tracers_flag       = .false.
  logical :: tritium_read_from_ic_file  = .false.  ! we inject via flux; default off

  real(r8) :: half_life_yr       = 12.32_r8       ! years
  integer  :: inject_nstep       = 0              ! fallback step (<=0 -> step 1)
  real(r8) :: inject_mass_kg     = 0._r8          ! if 0, convert from activity
  real(r8) :: inject_activity_Ci = 0._r8          ! alternative to mass
  real(r8) :: inject_lat_deg     = 0._r8
  real(r8) :: inject_lon_deg     = 0._r8          ! will be normalized to [0,360)

  ! Trigger options
  logical :: inject_at_first_step = .false.       ! nstep==1
  integer :: inject_year          = -1            ! calendar trigger active if >= 0
  integer :: inject_month         = -1            ! 1..12
  integer :: inject_day           = -1            ! 1..31
  integer :: inject_tod_in_sec    = 0             ! 0..86399 (UTC)

  !-------------------------------------------------------------
  ! Runtime state for the single injection cell
  !-------------------------------------------------------------
  integer  :: inj_gcol = -1        ! global column id of injection cell
  real(r8) :: inj_area = 0._r8     ! m^2, true cell area (not scaled by landfrac)
  logical  :: inj_done = .false.   ! ensure only one pulse occurs

  ! Map chunk -> local column index of inj_gcol (0 if chunk doesn't own it)
  integer, allocatable :: inj_i(:)

  ! Earth radius for great-circle distance (meters)
  real(r8), parameter :: rearth_m = 6371000._r8

!===============================================================================
contains
!===============================================================================

  subroutine tritium_tracers_readnl(nlfile)
    use namelist_utils, only: find_group_name
    use units,          only: getunit, freeunit
    use mpishorthand
    use cam_abortutils, only: endrun

    implicit none
   character(len=*), intent(in) :: nlfile

    integer :: unitn, ierr
    character(len=*), parameter :: subname = 'tritium_tracers_readnl'

    namelist /tritium_tracers_nl/ tritium_tracers_flag, tritium_read_from_ic_file, &
         half_life_yr, inject_lat_deg, inject_lon_deg, inject_nstep, inject_mass_kg, &
         inject_activity_Ci, inject_at_first_step, inject_year, inject_month, inject_day, inject_tod_in_sec

    if (masterproc) then
       unitn = getunit()
       open(unitn, file=trim(nlfile), status='old')
       call find_group_name(unitn, 'tritium_tracers_nl', status=ierr)
       if (ierr == 0) then
          read(unitn, tritium_tracers_nl, iostat=ierr)
          if (ierr /= 0) call endrun(subname//':: ERROR reading namelist')
       end if
       close(unitn)
       call freeunit(unitn)
    end if

#ifdef SPMD
    call mpibcast(tritium_tracers_flag,      1, mpilog,  0, mpicom)
    call mpibcast(tritium_read_from_ic_file, 1, mpilog,  0, mpicom)
    call mpibcast(half_life_yr,              1, mpir8,   0, mpicom)
    call mpibcast(inject_lat_deg,            1, mpir8,   0, mpicom)
    call mpibcast(inject_lon_deg,            1, mpir8,   0, mpicom)
    call mpibcast(inject_nstep,              1, mpiint,  0, mpicom)
    call mpibcast(inject_mass_kg,            1, mpir8,   0, mpicom)
    call mpibcast(inject_activity_Ci,        1, mpir8,   0, mpicom)
    call mpibcast(inject_at_first_step,      1, mpilog,  0, mpicom)
    call mpibcast(inject_year,               1, mpiint,  0, mpicom)
    call mpibcast(inject_month,              1, mpiint,  0, mpicom)
    call mpibcast(inject_day,                1, mpiint,  0, mpicom)
    call mpibcast(inject_tod_in_sec,         1, mpiint,  0, mpicom)
#endif

    ! Normalize longitude into [0,360)
    if (inject_lon_deg < 0.0_r8) then
       inject_lon_deg = inject_lon_deg + 360.0_r8
    else if (inject_lon_deg >= 360.0_r8) then
       inject_lon_deg = modulo(inject_lon_deg, 360.0_r8)
    end if

  end subroutine tritium_tracers_readnl

!===============================================================================

  subroutine tritium_tracers_register
    use physconst, only: cpair, mwdry
    if (.not. tritium_tracers_flag) return

    call cnst_add(c_names(1), mwdry, cpair, 0._r8, ixtrit, readiv=tritium_read_from_ic_file, &
                  longname='Tritium (decaying passive tracer)')
    ifirst = ixtrit
  end subroutine tritium_tracers_register

!===============================================================================

  function tritium_tracers_implements_cnst(name)
    !----------------------------------------------------------------------- 
    ! Purpose: return true if specified constituent is implemented by this package
    !-----------------------------------------------------------------------
    character(len=*), intent(in) :: name
    logical :: tritium_tracers_implements_cnst
    !---------------------------Local workspace-----------------------------
    integer :: m
    !-----------------------------------------------------------------------

    tritium_tracers_implements_cnst = .false.
    
    if (.not. tritium_tracers_flag) return

    do m = 1, ncnst
       if (name == c_names(m)) then
          tritium_tracers_implements_cnst = .true.
          return
       end if
    end do

  end function tritium_tracers_implements_cnst

!===============================================================================

  subroutine tritium_tracers_init_cnst(name, q, gcid)
    character(len=*), intent(in)  :: name
    real(r8),         intent(out) :: q(:,:)     ! kg/kg
    integer,          intent(in)  :: gcid(:)

    integer :: m
    if (.not. tritium_tracers_flag) return
    do m = 1, ncnst
       if (name == c_names(m)) then
          call init_cnst_3d(ifirst+m-1, q, gcid)
       end if
    end do
  end subroutine tritium_tracers_init_cnst

!===============================================================================

  subroutine tritium_tracers_init
    use cam_history, only: addfld, add_default

    integer :: m, mm
    if (.not. tritium_tracers_flag) return

    do m = 1, ncnst
       mm = ifirst + m - 1
       ! 3-D mixing ratio (kg/kg)
       call addfld (cnst_name(mm), (/ 'lev' /), 'A', 'kg/kg', cnst_longname(mm))
       call add_default (cnst_name(mm), 1, ' ')

       ! 3-D decay tendency (kg/kg/s)
       call addfld (dec_names(m), (/ 'lev' /), 'A', 'kg/kg/s', 'Tritium decay tendency')
       call add_default (dec_names(m), 1, ' ')

       ! Surface flux diagnostic: pack as 3-D on 'lev' with nonzero only at k=pver
       call addfld (src_names(m), (/ 'lev' /), 'A', 'kg/m2/s', 'Tritium surface mass flux (surface-only)')
       call add_default (src_names(m), 1, ' ')
    end do

    ! Identify the single global injection column and its area
    call locate_injection_target()

    ! Allocate per-chunk local-index map
    if (.not. allocated(inj_i)) allocate(inj_i(begchunk:endchunk))
    inj_i(:) = 0
  end subroutine tritium_tracers_init

!===============================================================================

  subroutine tritium_tracers_timestep_init(phys_state)
    use physics_types, only: physics_state

    type(physics_state), intent(inout), dimension(begchunk:endchunk), optional :: phys_state
    integer :: c, i, ncol

    if (.not. tritium_tracers_flag) return
    if (.not. present(phys_state)) return
    if (inj_gcol <= 0) return

    ! Build the map from chunk -> local column index of inj_gcol
    do c = begchunk, endchunk
       inj_i(c) = 0
       ncol = phys_state(c)%ncol
       if (ncol > 0) then
          do i = 1, ncol
             if (phys_state(c)%gncol(i) == inj_gcol) then
                inj_i(c) = i
                exit
             end if
          end do
       end if
    end do
  end subroutine tritium_tracers_timestep_init

!===============================================================================

  subroutine tritium_tracers_timestep_tend(state, ptend, cflx, landfrac, dt)
    use physics_types, only: physics_state, physics_ptend, physics_ptend_init
    use cam_history,   only: outfld
    use time_manager,  only: get_nstep, get_curr_date

    type(physics_state), intent(in)    :: state
    type(physics_ptend), intent(out)   :: ptend
    real(r8),            intent(inout) :: cflx(pcols,pcnst)  ! kg/m2/s
    real(r8),            intent(in)    :: landfrac(pcols)    ! unused here
    real(r8),            intent(in)    :: dt

    integer :: i, k
    integer :: lchnk, ncol
    integer :: nstep, target_nstep
    integer :: yr, mon, day, tod_i
    logical :: inject_now
    real(r8) :: lambda
    real(r8) :: M_release_kg, area_eff, flux0
    real(r8) :: src3d(pcols, pver)
    logical  :: lq(pcnst)

    if (.not. tritium_tracers_flag) then
       call physics_ptend_init(ptend, state%psetcols, 'trit_trc_ts')
       return
    end if

    lq(:)      = .false.
    lq(ixtrit) = .true.
    call physics_ptend_init(ptend, state%psetcols, 'tritium_tracers', lq=lq)

    nstep = get_nstep()
    call get_curr_date(yr, mon, day, tod_i)

    ! Trigger logic: priority = 1) first step, 2) calendar date/time, 3) inject_nstep, 4) step 1
    inject_now = .false.
    if (inject_at_first_step) then
       if (nstep == 1) inject_now = .true.
    else if (inject_year >= 0 .and. inject_month > 0 .and. inject_day > 0) then
       if (yr == inject_year .and. mon == inject_month .and. day == inject_day) then
          if ( real(tod_i, r8) >= real(inject_tod_in_sec, r8) .and. &
               real(tod_i, r8) <  real(inject_tod_in_sec, r8) + dt ) then
             inject_now = .true.
          end if
       end if
    else
      if (inject_nstep > 0) then
         target_nstep = inject_nstep
      else
         target_nstep = 1
      end if
      if (nstep == target_nstep) inject_now = .true.
    end if

    lchnk = state%lchnk
    ncol  = state%ncol

    ! Continuous first-order radioactive decay: dq/dt = -lambda * q
    lambda = log(2._r8) / (half_life_yr * 365.25_r8 * 86400._r8)
    do k = 1, pver
       do i = 1, ncol
          ptend%q(i,k,ixtrit) = -lambda * state%q(i,k,ixtrit)
       end do
    end do
    call outfld(dec_names(1), ptend%q(:,:,ixtrit), pcols, lchnk)

    ! Default: no flux
    cflx(:,ixtrit) = 0._r8

    ! One-time surface pulse into the single owning column
    if (.not. inj_done .and. inject_now) then
       M_release_kg = inject_mass_kg
       if (M_release_kg <= 0._r8 .and. inject_activity_Ci > 0._r8) then
          M_release_kg = activity_ci_to_kg(inject_activity_Ci, half_life_yr)
       end if

       if (M_release_kg > 0._r8 .and. inj_area > 0._r8) then
          if (inj_i(lchnk) > 0) then
             area_eff = inj_area
             if (area_eff <= 0._r8) then
                if (masterproc) write(iulog,*) 'TRITIUM WARNING: non-positive cell area; skip injection.'
             else
                flux0 = M_release_kg / (area_eff * dt)  ! kg m^-2 s^-1 during this step only
                cflx(inj_i(lchnk), ixtrit) = flux0
                inj_done = .true.
                if (masterproc) then
                   write(iulog,*) 'TRITIUM injected at gcol=', inj_gcol, ' chunk=', lchnk, ' i=', inj_i(lchnk), &
                                  ' mass(kg)=', M_release_kg, ' area(m2)=', area_eff, ' dt(s)=', dt
                end if
             end if
          end if
       end if
    end if

    ! Write TRITSRC as 3-D field with nonzero at surface level only
    src3d(:,:)      = 0._r8
    src3d(:,pver)   = cflx(:,ixtrit)
    call outfld(src_names(1), src3d, pcols, lchnk)

  end subroutine tritium_tracers_timestep_tend

!===============================================================================

  subroutine init_cnst_3d(m, q, gcid)
    integer,  intent(in)  :: m
    real(r8), intent(out) :: q(:,:)
    integer,  intent(in)  :: gcid(:)

    if (masterproc) write(iulog,*) 'TRITIUM: INITIALIZING ', cnst_name(m), m
    if (m == ixtrit) q(:,:) = 0._r8
  end subroutine init_cnst_3d

!===============================================================================

  subroutine locate_injection_target()
    use dyn_grid,  only: get_horiz_grid_d, get_horiz_grid_dim_d
    use physconst, only: pi

    integer :: plon, plat, ng, j
    real(r8), allocatable :: glat(:), glon(:), garea(:)
    real(r8) :: lat0, lon0, d, dbest

    call get_horiz_grid_dim_d(plon, plat)
    ng = plon*plat
    allocate(glat(ng), glon(ng), garea(ng))
    call get_horiz_grid_d(ng, glat, glon, garea)  ! outputs are in radians for lat/lon

    lat0 = deg2rad(inject_lat_deg)
    lon0 = deg2rad(inject_lon_deg)      ! already normalized to [0,360) in readnl
    lon0 = normlon(lon0)                ! convert to (-pi,pi] for distance calc

    inj_gcol = -1; inj_area = 0._r8
    dbest = 1.0e99_r8

    do j = 1, ng
       d = great_circle(glat(j), normlon(glon(j)), lat0, lon0)
       if (d < dbest) then
          dbest = d
          inj_gcol = j
       end if
    end do

    if (inj_gcol > 0) inj_area = garea(inj_gcol)

    if (masterproc) write(iulog,*) 'TRITIUM: inj_gcol=', inj_gcol, ' area(m2)=', inj_area

    deallocate(glat, glon, garea)
  end subroutine locate_injection_target

!-------------------------- helpers ---------------------------

  pure real(r8) function deg2rad(x) result(y)
    use physconst, only: pi
    real(r8), intent(in) :: x
    y = x * pi / 180._r8
  end function deg2rad

  pure real(r8) function normlon(lon) result(lon2)
    use physconst, only: pi
    real(r8), intent(in) :: lon
    lon2 = modulo(lon + pi, 2._r8*pi) - pi    ! map to (-pi,pi]
  end function normlon

  pure real(r8) function great_circle(lat1,lon1,lat2,lon2) result(d)
    real(r8), intent(in) :: lat1,lon1,lat2,lon2
    real(r8) :: a
    a = sin(0.5_r8*(lat2-lat1))**2 + cos(lat1)*cos(lat2)*sin(0.5_r8*(lon2-lon1))**2
    d = 2._r8*rearth_m*asin(min(1._r8, sqrt(a)))   ! meters
  end function great_circle

  pure real(r8) function activity_ci_to_kg(activity_Ci, half_life_years) result(m_kg)
    ! Convert activity (Ci) to mass (kg) at injection time using specific activity
    real(r8), intent(in) :: activity_Ci, half_life_years
    real(r8), parameter  :: NA  = 6.02214076e23_r8     ! 1/mol
    real(r8), parameter  :: M_T = 3.0160492e-3_r8      ! kg/mol (tritium)
    real(r8), parameter  :: CI_TO_BQ = 3.7e10_r8       ! Bq per Ci
    real(r8) :: lambda, SA_Bq_per_kg, A_Bq
    lambda        = log(2._r8) / (half_life_years * 365.25_r8 * 86400._r8)
    SA_Bq_per_kg  = (lambda * NA) / M_T
    A_Bq          = activity_Ci * CI_TO_BQ
    m_kg          = A_Bq / SA_Bq_per_kg
  end function activity_ci_to_kg

!=====================================================================
end module tritium_tracers