!===============================================================================
! Tritium Fate & Transport (single passive tracer with decay and injection)
! One-time surface injection of tritium tracer (TRIT, in Ci) at a specified 
! location and timestep. The code structure is following the AOA tracers module. 
! (register/init/init_cnst/timestep_init/timestep_tend/readnl, ncnst arrays, etc.).
! Development by S. Feng (PNNL), 2025.
!===============================================================================

module tritium_tracers

  use shr_kind_mod, only: r8 => shr_kind_r8
  use spmd_utils,   only: masterproc
  use ppgrid,       only: pcols, pver, begchunk, endchunk
  use constituents, only: pcnst, cnst_add, cnst_name, cnst_longname
  use cam_logfile,  only: iulog

  implicit none
  private
  save

  ! Public interfaces 
  public :: tritium_tracers_register         ! register constituents
  public :: tritium_tracers_implements_cnst  ! true if named constituent is implemented by this package
  public :: tritium_tracers_init_cnst        ! initialize constituent mixing ratio field at start of run
  public :: tritium_tracers_init             ! add history fields, allocate arrays
  public :: tritium_tracers_timestep_init    ! map global to local indices per chunk
  public :: tritium_tracers_timestep_tend    ! compute tendencies and fluxes
  public :: tritium_tracers_readnl           ! read namelist options

  !-------------------------------------------------------------
  ! Private module data
  !-------------------------------------------------------------
  integer, parameter :: ncnst = 1  ! number of constituents implemented by this module

  ! constituent names
  character(len=8), parameter :: c_names(ncnst) = (/'TRIT'/)

  ! constituent source/sink names (history tendencies)
  character(len=8), parameter :: src_names(ncnst) = (/'TRITSRC'/)

  integer :: ifirst         ! global index of first constituent
  integer :: ixtrit         ! global index for TRIT tracer

  ! Namelist variables 
  logical :: tritium_tracers_flag    = .false.   ! ON/OFF this package
  logical :: tritium_read_from_ic_file = .false. ! for parity; we inject via flux, so default false

  real(r8) :: half_life_yr    = 12.32_r8  ! Tritium half-life (years)
  integer  :: inject_nstep    = 0         ! timestep index to apply the pulse
  real(r8) :: inject_mass_kg  = 0._r8     ! total released mass (kg); if 0, use Ci
  ! using 1984 March case as an example
  real(r8) :: inject_activity_Ci = 7500._r8  ! total activity (Ci) for the pulse
  real(r8) :: inject_lat_deg  = 33.2850657_r8   ! target latitude (deg)
  real(r8) :: inject_lon_deg  = -81.6378505_r8 ! target longitude (deg)

  ! Derived runtime state for locating the single injection column
  integer  :: inj_gcol = -1        ! global physics-column id of target column
  real(r8) :: inj_area = 0._r8     ! m^2 area of that column
  logical  :: inj_done = .false.   ! inject only once
  !	When inj_done = .false. → the code is allowed to inject.
  ! The moment the one-timestep pulse is applied, the code sets inj_done = .true. 
  ! → meaning “we already injected on this run,” so it will never inject again (even if 
  ! nstep == inject_nstep is seen again later in the same run). 
  ! Per-chunk local mapping to the target column (index i for each chunk; -1 if not present)
  ! integer, allocatable :: inj_i(:)  ! removed, was: dimension(begchunk:endchunk)
  real(r8), parameter :: rearth_m = 6371000._r8  ! Earth radius [m] for great-circle distance

!===============================================================================
contains
!===============================================================================

  subroutine tritium_tracers_readnl(nlfile)
    use namelist_utils, only: find_group_name
    use units,          only: getunit, freeunit
    use mpishorthand
    use cam_abortutils, only: endrun
    
    implicit none

    character(len=*), intent(in) :: nlfile ! filepath for file containing namelist input
    
    ! local variables
    integer :: unitn, ierr
    character(len=*), parameter :: subname = 'tritium_tracers_readnl'

    namelist /tritium_tracers_nl/ tritium_tracers_flag, tritium_read_from_ic_file, &
         half_life_yr, inject_lat_deg, inject_lon_deg, inject_nstep, inject_mass_kg, &
         inject_activity_Ci
         
    !-----------------------------------------------------------------------------

    if (masterproc) then
       unitn = getunit()
       open(unitn, file=trim(nlfile), status='old')
       call find_group_name(unitn, 'tritium_tracers_nl', status=ierr)
       if (ierr == 0) then
          read(unitn, tritium_tracers_nl, iostat=ierr)
          if (ierr /= 0) call endrun(subname//':: ERROR reading namelist')
       end if
       close(unitn)
       call freeunit(unitn)
    end if

#ifdef SPMD
    call mpibcast(tritium_tracers_flag,    1, mpilog,  0, mpicom)
    call mpibcast(tritium_read_from_ic_file, 1, mpilog, 0, mpicom)
    call mpibcast(half_life_yr,            1, mpir8,   0, mpicom)
    call mpibcast(inject_lat_deg,          1, mpir8,   0, mpicom)
    call mpibcast(inject_lon_deg,          1, mpir8,   0, mpicom)
    call mpibcast(inject_nstep,            1, mpiint,  0, mpicom)
    call mpibcast(inject_mass_kg,          1, mpir8,   0, mpicom)
    call mpibcast(inject_activity_Ci,      1, mpir8,   0, mpicom)
#endif
  end subroutine tritium_tracers_readnl

!===============================================================================

  subroutine tritium_tracers_register
    !----------------------------------------------------------------------- 
    ! Purpose: register advected constituents
    !-----------------------------------------------------------------------  
    use physconst,  only: cpair, mwdry
    !-----------------------------------------------------------------------

    if (.not. tritium_tracers_flag) return
    
    call cnst_add(c_names(1), mwdry, cpair, 0._r8, ixtrit, readiv=tritium_read_from_ic_file, &
                  longname='Tritium (decaying passive tracer)')
    ifirst = ixtrit

  end subroutine tritium_tracers_register

!===============================================================================

  function tritium_tracers_implements_cnst(name)
    !----------------------------------------------------------------------- 
    ! Purpose: return true if specified constituent is implemented by this package
    !-----------------------------------------------------------------------
    character(len=*), intent(in) :: name
    logical :: tritium_tracers_implements_cnst
    !---------------------------Local workspace-----------------------------
    integer :: m
    !-----------------------------------------------------------------------

    tritium_tracers_implements_cnst = .false.
    
    if (.not. tritium_tracers_flag) return

    do m = 1, ncnst
       if (name == c_names(m)) then
          tritium_tracers_implements_cnst = .true.
          return
       end if
    end do

  end function tritium_tracers_implements_cnst

!===============================================================================

  subroutine tritium_tracers_init_cnst(name, q, gcid)

    !----------------------------------------------------------------------- 
    ! Purpose: initialize mixing ratio fields at the beginning of an initial run
    !-----------------------------------------------------------------------
    character(len=*), intent(in)  :: name
    real(r8),         intent(out) :: q(:,:)   ! kg tracer/kg dry air (gcol, plev)
    integer,          intent(in)  :: gcid(:)  ! global column id (unused here)
    integer :: m
    !-----------------------------------------------------------------------

    if (.not. tritium_tracers_flag) return

    do m = 1, ncnst
       if (name == c_names(m)) then
          ! pass global constituent index
          call init_cnst_3d(ifirst+m-1, q, gcid)
       end if
    end do

  end subroutine tritium_tracers_init_cnst

!===============================================================================

  subroutine tritium_tracers_init
    !----------------------------------------------------------------------- 
    ! Purpose: initialize age of air constituents (declare history variables)
    !-----------------------------------------------------------------------
    use cam_history, only: addfld, add_default
    integer :: m, mm
    !-----------------------------------------------------------------------

    if (.not. tritium_tracers_flag) return

    do m = 1, ncnst
       mm = ifirst + m - 1
       call addfld (cnst_name(mm), (/ 'lev' /), 'A', 'kg/kg', cnst_longname(mm))
       call addfld (src_names(m),  (/ 'lev' /), 'A', 'kg/kg/s', trim(cnst_name(mm))//' source/sink')

       call add_default (cnst_name(mm), 1, ' ')
       call add_default (src_names(m),  1, ' ')
    end do

    ! additional setup for tracer injection
    call locate_injection_target()         ! find nearest column and set a default area

  end subroutine tritium_tracers_init

!===============================================================================

  subroutine tritium_tracers_timestep_init(phys_state)
    !-----------------------------------------------------------------------
    ! Purpose: (no-op) We do not map global->local indices here. The one-time
    ! injection chooses a local column at runtime in timestep_tend.
    !-----------------------------------------------------------------------
    
    use ppgrid,         only: begchunk, endchunk
    use physics_types, only: physics_state
    
    type(physics_state), intent(inout), dimension(begchunk:endchunk), optional :: phys_state
    
    ! integer :: c, i
    !--------------------------------------------------------------------------

    if (.not. tritium_tracers_flag) return

    ! No per-timestep reinit or mapping needed.

  end subroutine tritium_tracers_timestep_init

!===============================================================================

  subroutine tritium_tracers_timestep_tend(state, ptend, cflx, landfrac, dt)

    use physics_types, only: physics_state, physics_ptend, physics_ptend_init
    use cam_history,   only: outfld
    use time_manager,  only: get_nstep
    
    ! Arguments
    type(physics_state), intent(in)    :: state              ! state variables 
    type(physics_ptend), intent(out)   :: ptend              ! package tendencies
    real(r8),            intent(inout) :: cflx(pcols,pcnst)  ! Surface constituent flux kg m^-2 s^-1
    real(r8),            intent(in)    :: landfrac(pcols)    ! Land fraction
    real(r8),            intent(in)    :: dt                 ! timestep 

    !----------------- Local workspace-------------------------------
    integer :: i, k
    integer :: lchnk                            ! chunk identifier
    integer :: ncol                             ! number of columns in this chunk
    integer :: nstep                            ! current timestep index             
    real(r8) :: lambda                          ! radioactive decay constant (units: s⁻¹)
    real(r8) :: flux0                           ! flux to inject (kg m^-2 s^-1) 
    real(r8) :: M_release_kg                    ! total mass to inject (kg)
    real(r8) :: area_eff                        ! effective surface area for injection (m^2)
    integer  :: ibest
    real(r8) :: dbest, dlat0, d

    logical  :: lq(pcnst)
    !------------------------------------------------------------------

    if (.not. tritium_tracers_flag) then
       call physics_ptend_init(ptend, state%psetcols, 'trit_trc_ts')
       return
    end if

    lq(:)      = .FALSE.
    lq(ixtrit) = .TRUE.
    call physics_ptend_init(ptend, state%psetcols, 'tritium_tracers', lq=lq)

    nstep = get_nstep()
    lchnk = state%lchnk
    ncol  = state%ncol

    ! Radioactive decay tendency: dq/dt = -lambda * q
    lambda = log(2._r8) / (half_life_yr * 365.25_r8 * 86400._r8)
    do k = 1, pver
       do i = 1, ncol
          ptend%q(i,k,ixtrit) = -lambda * state%q(i,k,ixtrit)
       end do
    end do

    ! Record decay tendency on history
    call outfld (src_names(1), ptend%q(:,:,ixtrit), pcols, lchnk)

    ! Default: no surface flux
    cflx(:,ixtrit) = 0._r8

    ! One-time surface injection at specified timestep into the selected column
    if (.not. inj_done .and. nstep == inject_nstep) then
       ! Determine total mass to inject (prefer kg; else convert from Ci)
       M_release_kg = inject_mass_kg
       if (M_release_kg <= 0._r8 .and. inject_activity_Ci > 0._r8) then
          M_release_kg = activity_ci_to_kg(inject_activity_Ci, half_life_yr)
       end if

       if (M_release_kg > 0._r8 .and. inj_area > 0._r8) then
          ! Choose nearest local column by latitude (lon-agnostic)
          ibest = 1; dbest = 1.0e99_r8
          dlat0 = deg2rad(inject_lat_deg)
          do i = 1, ncol
             d = abs(state%lat(i) - dlat0)
             if (d < dbest) then
                dbest = d; ibest = i
             end if
          end do
          ! Use actual grid cell area for the chosen column (do not scale by landfrac)
          area_eff = inj_area
          if (area_eff <= 0._r8) then
             if (masterproc) write(iulog,*) 'TRITIUM WARNING: cell area is non-positive at injection cell; skipping injection.'
          else
             flux0 = M_release_kg / (area_eff * dt)   ! kg m^-2 s^-1 during this step only
             cflx(ibest, ixtrit) = flux0
             inj_done = .true.
          end if
       end if
    end if

  end subroutine tritium_tracers_timestep_tend

!===============================================================================

  subroutine init_cnst_3d(m, q, gcid)
    ! Structured like AOA's init_cnst_3d; TRIT starts at zero everywhere.
    ! Removed unused 'use dycore' and 'use dyn_grid'
    integer,  intent(in)  :: m       ! global constituent index
    real(r8), intent(out) :: q(:,:)  ! kg tracer/kg dry air (gcol,plev)
    integer,  intent(in)  :: gcid(:) ! global column id (unused)

    if (masterproc) write(iulog,*) 'TRITIUM: INITIALIZING ', cnst_name(m), m

    if (m == ixtrit) then
       q(:,:) = 0.0_r8
    end if
  end subroutine init_cnst_3d

!===============================================================================

  subroutine locate_injection_target()
    use dyn_grid,  only: get_horiz_grid_d, get_horiz_grid_dim_d
    use physconst, only: pi

    integer :: plon, plat, ng, j
    real(r8), allocatable :: glat(:), glon(:), garea(:)
    real(r8) :: lat0, lon0, d, dbest

    call get_horiz_grid_dim_d(plon, plat)
    ng = plon*plat
    allocate(glat(ng), glon(ng), garea(ng))
    call get_horiz_grid_d(ng, glat, glon, garea)

    lat0 = deg2rad(inject_lat_deg)
    lon0 = deg2rad(inject_lon_deg)

    inj_gcol = -1; inj_area = 0._r8

    ! Pick the global column nearest to (lat0,lon0)
    dbest = 1.0e99_r8
    do j = 1, ng
       d = great_circle(glat(j), normlon(glon(j)), lat0, normlon(lon0))
       if (d < dbest) then
          dbest = d
          inj_gcol = j
       end if
    end do

    if (inj_gcol > 0) then
       inj_area = garea(inj_gcol)
    else
       inj_area = 0._r8
    end if

    if (masterproc) then
       write(iulog,*) 'TRITIUM: selected global column =', inj_gcol, ' area(m^2)=', inj_area
    end if

    deallocate(glat, glon, garea)
  end subroutine locate_injection_target

!-------------------------- helpers ---------------------------

  pure real(r8) function deg2rad(x) result(y)
    use physconst, only: pi
    real(r8), intent(in) :: x
    y = x * pi / 180._r8
  end function deg2rad

  pure real(r8) function normlon(lon) result(lon2)
    use physconst, only: pi
    real(r8), intent(in) :: lon
    lon2 = modulo(lon + pi, 2._r8*pi) - pi
  end function normlon

  pure real(r8) function great_circle(lat1,lon1,lat2,lon2) result(d)
    real(r8), intent(in) :: lat1,lon1,lat2,lon2
    real(r8) :: a
    a = sin(0.5_r8*(lat2-lat1))**2 + cos(lat1)*cos(lat2)*sin(0.5_r8*(lon2-lon1))**2
    d = 2._r8*rearth_m*asin(min(1._r8, sqrt(a)))   ! meters
  end function great_circle

  pure real(r8) function activity_ci_to_kg(activity_Ci, half_life_years) result(m_kg)
    ! Convert total activity (Ci) at injection time to mass (kg) for Tritium
    real(r8), intent(in) :: activity_Ci, half_life_years
    real(r8), parameter  :: NA  = 6.02214076e23_r8       ! 1/mol
    real(r8), parameter  :: M_T = 3.0160492e-3_r8        ! kg/mol (Tritium molar mass)
    real(r8), parameter  :: CI_TO_BQ = 3.7e10_r8         ! Bq per Ci
    real(r8) :: lambda, SA_Bq_per_kg, A_Bq
    lambda        = log(2._r8) / (half_life_years * 365.25_r8 * 86400._r8)
    SA_Bq_per_kg  = (lambda * NA) / M_T
    A_Bq          = activity_Ci * CI_TO_BQ
    m_kg          = A_Bq / SA_Bq_per_kg
  end function activity_ci_to_kg

!=====================================================================
end module tritium_tracers